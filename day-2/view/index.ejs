<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modern Theme</title>
    <style>
      :root {
        --bg-1: #0f172a;
        --bg-2: #111827;
        --panel: rgba(15, 23, 42, 0.7);
        --panel-border: rgba(148, 163, 184, 0.2);
        --primary: #8b5cf6;
        --secondary: #22d3ee;
        --highlight: #f59e0b;
        --text: #e2e8f0;
        --muted: #cbd5e1;
        --shadow: rgba(15, 23, 42, 0.45);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Arial, Helvetica, sans-serif;
        background: radial-gradient(circle at top, #1e293b 0%, var(--bg-1) 45%, var(--bg-2) 100%);
        color: var(--text);
      }

      .container {
        width: min(900px, 92vw);
        background: var(--panel);
        backdrop-filter: blur(12px);
        border: 1px solid var(--panel-border);
        border-radius: 28px;
        box-shadow: 0 30px 80px var(--shadow);
        padding: 50px 48px;
      }

      .badge {
        display: inline-block;
        padding: 8px 14px;
        background: rgba(139, 92, 246, 0.15);
        color: #ddd6fe;
        border: 1px solid rgba(139, 92, 246, 0.4);
        border-radius: 999px;
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
      }

      h1 {
        margin: 22px 0 14px;
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        line-height: 1.1;
      }

      .gradient-text {
        background: linear-gradient(135deg, var(--secondary), var(--primary), var(--highlight));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      p {
        max-width: 640px;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--muted);
      }

      .actions {
        margin-top: 28px;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 150px;
        padding: 14px 22px;
        border-radius: 12px;
        border: none;
        font-weight: 700;
        font-size: 0.98rem;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .btn:hover {
        transform: translateY(-2px);
      }

      .btn.primary {
        background: linear-gradient(135deg, var(--primary), #7c3aed);
        color: white;
        box-shadow: 0 16px 30px rgba(124, 58, 237, 0.35);
      }

      .btn.secondary {
        background: rgba(34, 211, 238, 0.08);
        color: var(--secondary);
        border: 1px solid rgba(34, 211, 238, 0.3);
      }

      .stats {
        margin-top: 38px;
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 18px;
      }

      .stat {
        padding: 18px 16px;
        border-radius: 16px;
        background: rgba(148, 163, 184, 0.05);
        border: 1px solid rgba(148, 163, 184, 0.12);
      }

      .stat strong {
        display: block;
        font-size: 1.5rem;
        margin-bottom: 6px;
      }

      .stat span {
        color: var(--muted);
        font-size: 0.9rem;
      }

      @media (max-width: 640px) {
        .container {
          padding: 36px 22px;
        }

        .stats {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main class="container">
      <div class="badge">Fresh Look</div>
      <h1>
        Build something <span class="gradient-text">beautiful</span>.
      </h1>
      <p>
        This theme gives your app a modern, premium feel with a dark glassmorphism look,
        soft gradients, and polished call-to-action buttons.
      </p>

      <div class="actions">
        <button class="btn primary">Get Started</button>
        <button class="btn secondary">View Demo</button>
      </div>

      <div class="stats">
        <div class="stat">
          <strong>24k</strong>
          <span>users</span>
        </div>
        <div class="stat">
          <strong>99.9%</strong>
          <span>uptime</span>
        </div>
        <div class="stat">
          <strong>3x</strong>
          <span>faster</span>
        </div>
      </div>
    </main>
  </body>
</html>
