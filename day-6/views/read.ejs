<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0b1020">
    <title>Users</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div>
        <h2 class="text-xl font-semibold text-cyan-300"><a href="/">->back to home</a></h2>
    </div>
    <main class="min-h-screen px-5 py-12 sm:px-8">
        <div class="mx-auto max-w-6xl">
            <header class="mb-10">
                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300">Directory</p>
                <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Users</h1>
                <p class="mt-3 text-slate-400">Browse the users in your collection.</p>
            </header>

            <% if (users.length) { %>
                <section aria-label="User cards" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                    <% users.forEach((user) => { %>
                        <article class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/80 shadow-xl shadow-black/20">
                            <img
                                src="<%= user.imageUrl %>"
                                alt="Image for <%= user.name %>"
                                class="h-56 w-full object-cover"
                                loading="lazy"
                            >
                            <div class="p-6">
                                <h2 class="break-words text-xl font-semibold text-white"><%= user.name %></h2>
                                <p class="mt-2 break-all text-sm text-slate-400"><%= user.email %></p>
                                <div class="mt-5 flex gap-3">
                                    <a
                                        href="/edit/<%= user._id %>"
                                        class="rounded-lg bg-cyan-300 px-4 py-2 text-sm font-semibold text-slate-950 transition hover:bg-cyan-200"
                                    >Edit</a>
                                    <form action="/delete/<%= user._id %>" method="post">
                                        <button
                                            type="submit"
                                            class="rounded-lg border border-rose-400/40 bg-rose-400/10 px-4 py-2 text-sm font-semibold text-rose-200 transition hover:bg-rose-400/20"
                                        >Delete</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    <% }); %>
                </section>
            <% } else { %>
                <p class="rounded-2xl border border-white/10 bg-slate-900/80 px-6 py-8 text-center text-slate-400">
                    No users found.
                </p>
            <% } %>
        </div>
    </main>
</body>
</html>